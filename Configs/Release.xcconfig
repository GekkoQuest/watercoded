#include "Base.xcconfig"

// Ad-hoc signed for GitHub distribution; Sparkle signs update archives separately.
// Developer ID + notarization can be added later; see docs/RELEASING.md.
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
DEAD_CODE_STRIPPING = YES

// One download for Apple silicon and Intel Macs that support macOS 26.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
