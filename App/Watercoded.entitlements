<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Agents run user-installed CLIs against arbitrary repositories, so the app is not sandboxed.
       See docs/adr/0001-native-macos-app.md. Hardened Runtime is enabled for distribution. -->
  <key>com.apple.security.app-sandbox</key>
  <false/>
  <!-- Ad-hoc builds have no Team ID, so they cannot use library validation with Sparkle.
       Remove this exception when migrating distribution to Developer ID signing. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
